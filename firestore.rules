rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Temporary Single-Use Pairing Tokens
    // Created by visually impaired NAVIDOOR user, claimed by Family Companion
    match /pairing_tokens/{token} {
      // Authenticated users can read the token they created or are claiming
      allow read: if isAuthenticated();

      // Only the NAVIDOOR user can create a token for themselves
      // Must be single-use, status 'active', and valid expiry (within 5 minutes)
      allow create: if isAuthenticated() 
        && request.resource.data.navidoorUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.singleUse == true
        && request.resource.data.expiresAt > request.time.toMillis();

      // Token can only be updated:
      // a) By companion claiming it (status must transition from 'active' to 'claimed', cannot self-pair, cannot be expired)
      // b) Marked 'expired'
      allow update: if isAuthenticated() && (
        (
          resource.data.status == 'active'
          && resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == request.auth.uid
          && request.auth.uid != resource.data.navidoorUid
        ) || (
          request.resource.data.status == 'expired'
        )
      );

      // Only the creator can delete their pairing token
      allow delete: if isAuthenticated() && resource.data.navidoorUid == request.auth.uid;
    }

    // 2. Family Connections (Caregiver <-> NAVIDOOR User)
    match /connections/{connectionId} {
      // Only the involved NAVIDOOR user or companion can read connection data
      allow read: if isAuthenticated() && (
        resource.data.navidoorUid == request.auth.uid ||
        resource.data.companionUid == request.auth.uid
      );

      // Only the authenticated companion can initiate a connection request, and it must start as 'pending'
      // Clients CANNOT create arbitrary 'connected' states directly without user approval
      allow create: if isAuthenticated()
        && request.resource.data.companionUid == request.auth.uid
        && request.resource.data.navidoorUid != request.auth.uid
        && request.resource.data.status == 'pending';

      // Updates strictly governed by role:
      // - NAVIDOOR user approves ('connected') or rejects ('rejected')
      // - Either user can revoke ('disconnected')
      allow update: if isAuthenticated() && (
        // NAVIDOOR user approval/rejection
        (
          resource.data.navidoorUid == request.auth.uid &&
          (request.resource.data.status == 'connected' || request.resource.data.status == 'rejected')
        ) ||
        // Either participant revoking/disconnecting
        (
          (resource.data.navidoorUid == request.auth.uid || resource.data.companionUid == request.auth.uid) &&
          request.resource.data.status == 'disconnected'
        )
      );

      // Deletions disallowed to maintain audit integrity
      allow delete: false;
    }

    // 3. User Profiles & Settings
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }
  }
}
