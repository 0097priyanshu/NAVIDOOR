{
  "name": "navidoor-app",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "tsc --noEmit",
    "server": "node backend/index.js",
    "flutter:run": "flutter run -d chrome --target navidoor_flutter/lib/main.dart",
    "flutter:web": "flutter run -d chrome --target navidoor_flutter/lib/main.dart",
    "flutter:desktop": "flutter run -d windows --target navidoor_flutter/lib/main.dart"
  },
  "dependencies": {
    "@expo/html-elements": "^0.9.0",
    "@expo/metro-runtime": "~3.2.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "cors": "^2.8.6",
    "expo": "latest",
    "expo-av": "~14.0.7",
    "expo-camera": "~15.0.16",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-location": "~17.0.1",
    "expo-speech": "~12.0.2",
    "expo-status-bar": "~1.12.1",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.395.0",
    "lucide-react-native": "^0.395.0",
    "multer": "^1.4.5-lts.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.11",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  },
