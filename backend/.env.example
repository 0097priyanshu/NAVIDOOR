# NAVIDOOR Backend Environment Configuration
# Copy this file to backend/.env and replace with your Neon Serverless Postgres URLs

# 1. Neon Pooled Connection String (used by Express runtime queries)
# Example: postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=""

# 2. Neon Direct Connection String (used by Prisma CLI migrations: npx prisma db push)
# Example: postgresql://neondb_owner:PASSWORD@ep-xxxx.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=""

# Optional Microservice Overrides
PORT=5001
OCR_SERVICE_URL=http://127.0.0.1:5004
YOLO_SERVICE_URL=http://127.0.0.1:5003
INDICF5_SERVER_URL=http://127.0.0.1:5002
LLM_BASE_URL=http://127.0.0.1:11434
